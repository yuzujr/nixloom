# `nixloom env init` installs this as <state-directory>/.env. It is the single
# host-local boundary: secrets, exposure and identity stay there and never
# enter Git.
TAVILY_API_KEY=
SILLYTAVERN_AUTH_PASSWORD=
CIVITAI_API_TOKEN=

# Optional host settings; committed defaults remain loopback-only.
# NIXLOOM_REMOTE=true
# NIXLOOM_WEBUI_ORIGINS='http://127.0.0.1:3000;https://ai.example.net'
# SILLYTAVERN_AUTH_USER=nixloom
